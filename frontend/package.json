{
  "name": "prisma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev-lean": "OMIT_VUE_DEVTOOLS=true vite",
    "build": "vite build",
    "preview": "vite preview",
    "test-unit": "vitest",
    "test-e2e": "playwright test",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"e2e/**/*.ts\" \"*.{ts,js}\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@vueform/slider": "^2.1.10",
    "pinia": "^4.0.3",
    "sweetalert2": "^11.26.25",
    "uuid": "^14.0.2",
    "vue": "^3.4.21",
    "vue-router": "^5.3.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.1",
    "prettier": "3.9.9",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.13"
  }
}
